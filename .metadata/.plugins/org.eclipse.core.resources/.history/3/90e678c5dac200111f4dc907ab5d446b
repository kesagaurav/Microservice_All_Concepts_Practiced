	@Override
	public EmployeeDTO updateEmployee(EmployeeDTO edto, int eid) throws EmployeeException {
		// TODO Auto-generated method stub
		Employee orElseThrow = erepo.findById(eid).orElseThrow(()->new EmployeeException("id is not found " + eid));
		orElseThrow.setName(edto.getName());
		orElseThrow.setDept(edto.getName());
		orElseThrow.setSal(edto.getSal());
		Employee save = erepo.save(orElseThrow);
		return EmployeeDTO.entityToDTO(save);
	}

	@Override
